<nav class="navbar">
    <div class="navbar-content">
        <a class="navbar-brand" href="">AppHost</a>
        <div class="nav-items">
            <NavLink style="text-decoration: none;" class="nav-item" href="" Match="NavLinkMatch.All">
                <span class="icon bi bi-house-door-fill" aria-hidden="true"></span>
                <span class="label">Home</span>
            </NavLink>
            <NavLink style="text-decoration: none;" class="nav-item" href="dashboard">
                <span class="icon bi bi-plus-square-fill" aria-hidden="true"></span>
                <span class="label">Dashboard</span>
            </NavLink>
            <NavLink style="text-decoration: none;" class="nav-item" href="projects">
                <span class="icon bi bi-list-nested" aria-hidden="true"></span>
                <span class="label">Projects</span>
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <button type="button" class="logout-button" @onclick="HandleLogout">
                    Logout
                </button>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    [Inject]
    private AppHost.Web.Services.AuthService AuthService { get; set; } = null!;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}
