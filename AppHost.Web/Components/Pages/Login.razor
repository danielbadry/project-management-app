@page "/login"
@using AppHost.Web.Components.Layouts
@layout AuthLayout

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Login</PageTitle>

<section class="login-shell" aria-labelledby="login-title">
    <div class="login-panel">
        <div class="login-heading">
            <span class="login-badge">Project Management</span>
            <h1 id="login-title">Sign in</h1>
            <p>Continue to your workspace.</p>
        </div>

        <EditForm Model="@LoginDto" FormName="Login" OnValidSubmit="HandleLogin" class="login-form">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="username">Username</label>
                <input id="username" name="username" class="field-input" autocomplete="username"
                       @bind="LoginDto.Username" @bind:event="oninput" />
                <ValidationMessage For="@(() => LoginDto.Username)" />
            </div>

            <div class="field">
                <label for="password">Password</label>
                <input id="password" name="password" type="password" class="field-input" autocomplete="current-password"
                       @bind="LoginDto.Password" @bind:event="oninput" />
                <ValidationMessage For="@(() => LoginDto.Password)" />
            </div>

            @if (!string.IsNullOrWhiteSpace(LoginErrorMessage))
            {
                <div class="form-error" role="alert">@LoginErrorMessage</div>
            }

            <button class="login-button" type="submit">Login</button>
        </EditForm>
        <br />
        Don't have an account? <a href="./register" type="button">Register</a>
    </div>
</section>
