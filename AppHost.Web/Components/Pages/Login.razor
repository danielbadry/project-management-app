@page "/login"
@using AppHost.Web.Components.Layouts
@layout AuthLayout

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Login</PageTitle>

<section class="login-shell" aria-labelledby="login-title">
    <div class="login-panel">
        <div class="login-heading">
            <span class="login-badge">Project Management</span>
            <h1 id="login-title">Sign in</h1>
            <p>Continue to your workspace.</p>
        </div>

        <EditForm Model="@LoginDto" FormName="Login" OnValidSubmit="HandleLogin" class="login-form">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="username">Username</label>
                <InputText id="username" class="field-input" @bind-Value="LoginDto.Username" autocomplete="username" />
                <ValidationMessage For="@(() => LoginDto.Username)" />
            </div>

            <div class="field">
                <label for="password">Password</label>
                <InputText id="password" type="password" class="field-input" @bind-Value="LoginDto.Password"
                           autocomplete="current-password" />
                <ValidationMessage For="@(() => LoginDto.Password)" />
            </div>

            @if (!string.IsNullOrWhiteSpace(LoginErrorMessage))
            {
                <div class="form-error" role="alert">@LoginErrorMessage</div>
            }

            <button class="login-button" type="submit">Login</button>
        </EditForm>
    </div>
</section>
